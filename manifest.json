{
  "manifest_version": 3,
  "name": "LifeRSS",
  "version": "0.1.0",
  "description": "Keyboard-first local RSS reader for Firefox.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "LifeRSS",
    "default_panel": "sidebar.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "liferss@local-reader.example",
      "strict_min_version": "115.0"
    }
  }
}
