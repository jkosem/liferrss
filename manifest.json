{
  "manifest_version": 3,
  "name": "LiferRSS",
  "version": "0.1.1",
  "description": "Keyboard-first local RSS reader for Firefox.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "feed-utils.js",
      "opml.js",
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "LiferRSS",
    "default_panel": "sidebar.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "liferss@local-reader.example",
      "strict_min_version": "115.0"
    }
  },
  "action": {
    "default_title": "Find feeds with LiferRSS",
    "default_popup": "discovery.html"
  }
}
